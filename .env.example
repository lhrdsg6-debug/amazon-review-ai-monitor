# Copy to .env and fill in your own keys. Never commit .env.
APIFY_TOKEN=
LLM_API_KEY=
# Optional compatibility alias used by some OpenAI-compatible Claude gateways.
LANYI_API_KEY=

# Defaults match the original demo setup.
LLM_BASE_URL=https://lanyiapi.com/v1/chat/completions
LLM_MODEL=claude-sonnet-4-6
APIFY_ACTOR_ID=web_wanderer/amazon-reviews-extractor

# Cost model for pre-run estimate and run stats.
APIFY_COST_PER_REVIEW_USD=0.001
LLM_INPUT_USD_PER_1M=3.0
LLM_OUTPUT_USD_PER_1M=15.0
